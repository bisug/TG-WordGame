# ==============================================
# WordSeek Bot Configuration
# ==============================================

# Your Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Secret key for daily Wordle signature/verification (used internally)
DAILY_WORDLE_SECRET=your_daily_wordle_secret_here

# Starting date for daily Wordle rotation (YYYY-MM-DD)
DAILY_WORDLE_START_DATE=2025-01-01


# ==============================================
# Database Configuration
# ==============================================

# PostgreSQL connection string
# Examples:
# postgresql://postgres:password@localhost:5432/wordseek
# postgresql://wordseek:wordseek_change_me@postgres:5432/wordseek
# postgresql://user:pass@host:port/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/wordseek

# Force PostgreSQL SSL on/off.
# Leave commented for the default behavior:
# enabled when NODE_ENV=production, disabled otherwise.
# DATABASE_SSL=false

# Verify PostgreSQL TLS certificates in production.
# Defaults to false for Heroku/Render/Railway compatibility.
# Set to true only when your database provider supports trusted CA verification.
DATABASE_SSL_REJECT_UNAUTHORIZED=false


# ==============================================
# Valkey / Redis Configuration
# ==============================================

# Redis-protocol connection URI. Valkey uses the same URI format.
# Examples:
# redis://127.0.0.1:6379
# redis://:password@127.0.0.1:6379
# redis://username:password@host:port
# Heroku-style REDIS_URL is also accepted as a fallback.
REDIS_URI=redis://127.0.0.1:6379


# ==============================================
# Environment
# ==============================================

# Options: development, production
NODE_ENV=development

# Enable health check server (required for Render free tier)
# Options: true, false
WEB_SERVICE=false



# ==============================================
# Admin Configuration
# ==============================================

# Comma-separated list of Telegram User IDs with admin privileges
# Example: 123456789,987654321
ADMIN_USERS=7324550618


# ==============================================
# Feature: Timezone
# ==============================================

# Used for Daily Wordle reset time
# Example: Asia/Kathmandu, UTC, Europe/London
TIME_ZONE=UTC


# ==============================================
# Optional Channels
# ==============================================

# Bot logs channel (optional)
LOGS_CHANNEL=

# Updates channel link (optional)
UPDATES_CHANNEL=https://t.me/WordSeek

# Discussion group link (optional)
DISCUSSION_GROUP=https://t.me/WordGuesser


# ==============================================
# External APIs (Optional)
# ==============================================

# Telegram Bot API root
CUSTOM_API_ROOT=https://api.telegram.org

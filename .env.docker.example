# ==============================================
# WordSeek Docker Compose Configuration
# ==============================================

BOT_TOKEN=your_bot_token_here
DAILY_WORDLE_SECRET=your_daily_wordle_secret_here
ADMIN_USERS=7324550618

NODE_ENV=production
WEB_SERVICE=false
TIME_ZONE=UTC

# Docker images pinned to stable releases available in May 2026.
POSTGRES_IMAGE=postgres:18.4-alpine3.23
CACHE_IMAGE=valkey/valkey:9.1.0-alpine3.23
# To use Redis Open Source instead of Valkey, set:
# CACHE_IMAGE=redis:8.8.0-alpine3.23

# Internal Compose database. Keep WORDSEEK_DATABASE_URL in sync if you change
# these credentials.
POSTGRES_DB=wordseek
POSTGRES_USER=wordseek
POSTGRES_PASSWORD=wordseek_change_me
POSTGRES_PGDATA=/var/lib/postgresql/18/docker
WORDSEEK_DATABASE_URL=postgresql://wordseek:wordseek_change_me@postgres:5432/wordseek
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Internal Compose Valkey/Redis-compatible cache.
WORDSEEK_REDIS_URI=redis://redis:6379

CUSTOM_API_ROOT=https://api.telegram.org
UPDATES_CHANNEL=https://t.me/WordSeek
DISCUSSION_GROUP=https://t.me/WordGuesser

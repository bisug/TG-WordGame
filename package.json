{
  "name": "word-guesser-bot",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.4.5"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "bun check",
    "lint": "oxlint && bun fmt --check",
    "format": "bun fmt",
    "test": "bun test",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "db:migrate": "kysely migrate:latest",
    "db:codegen": "kysely-codegen --out-file ./src/database-schemas.ts --singularize --camel-case"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "kysely-codegen": "0.20.0",
    "oxlint": "1.94.0",
    "pino-pretty": "13.2.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ioredis": "^6.1.0",
    "js-yaml": "^4.3.2",
    "fflate": "^0.8.2"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/runner": "^2.0.3",
    "bullmq": "^6.7.8",
    "grammy": "^1.48.0",
    "ioredis": "^6.1.0",
    "kysely": "^0.29.9",
    "kysely-ctl": "^0.22.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}

{
  "name": "word-guesser-bot",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=20"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "test": "bun test",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "db:migrate": "kysely migrate:latest",
    "db:seed": "kysely seed:run",
    "db:codegen": "kysely-codegen --out-file ./src/database-schemas.ts --singularize --camel-case"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "kysely-codegen": "0.20.0",
    "pino-pretty": "13.2.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ioredis": "^6.0.0",
    "js-yaml": "^4.3.2",
    "fflate": "^0.8.2"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/runner": "^2.0.3",
    "bullmq": "^6.5.0",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.7",
    "kysely-ctl": "^0.22.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}

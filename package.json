{
  "name": "word-guesser-bot",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": "1.3.13",
    "node": ">=20"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "bunx -p @typescript/native-preview tsgo --noEmit",
    "lint": "prettier --check \"src/**/*.{ts,tsx}\" \"migrations/**/*.ts\" \"*.{json,md,yml,yaml}\" \".github/**/*.yml\"",
    "test": "bun test",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "db:migrate": "kysely migrate:latest",
    "db:seed": "kysely seed:run",
    "db:codegen": "kysely-codegen --out-file ./src/database-schemas.ts --singularize --camel-case"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "1.3.14",
    "@types/pg": "^8.20.0",
    "kysely-codegen": "^0.19.0",
    "prettier": "^3.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/parse-mode": "^2.3.0",
    "@grammyjs/runner": "^2.0.3",
    "@types/react": "^19.2.14",
    "bullmq": "^5.76.6",
    "cron": "^4.4.0",
    "grammy": "^1.42.0",
    "ioredis": "^5.10.1",
    "kysely": "^0.29.0",
    "kysely-ctl": "^0.21.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "word-definition": "^2.1.6",
    "zod": "^4.4.3"
  }
}

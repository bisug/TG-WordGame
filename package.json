{
  "name": "word-guesser-bot",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14",
    "node": ">=20"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "bunx -p @typescript/native-preview tsgo --noEmit",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "test": "bun test",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "db:migrate": "kysely migrate:latest",
    "db:seed": "kysely seed:run",
    "db:codegen": "kysely-codegen --out-file ./src/database-schemas.ts --singularize --camel-case"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "1.3.14",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "kysely-codegen": "0.20.0",
    "pino-pretty": "13.1.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ioredis": "6.0.0",
    "js-yaml": "4.3.1"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/parse-mode": "^2.3.0",
    "@grammyjs/runner": "^2.0.3",
    "bullmq": "6.3.3",
    "grammy": "1.45.1",
    "ioredis": "6.0.0",
    "kysely": "0.29.5",
    "kysely-ctl": "0.21.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "satori": "0.29.0",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  }
}
